[Unit]
Description=KNX to OpenHAB Backup Cleanup
After=network.target
Requires=knxohui-update-recovery.service
After=knxohui-update-recovery.service

[Service]
Type=oneshot
User=knxohui
Group=knxohui
EnvironmentFile=/etc/knx_to_openhab/paths.env
ExecStart=/usr/local/libexec/knx_to_openhab/launch_backup_cleanup.sh

[Install]
WantedBy=multi-user.target

[Unit]
Description=KNX to OpenHAB Daily Backup Cleanup Timer
Documentation=https://github.com/diddip21/knx_to_openhab
Requires=knxohui-update-recovery.service
After=knxohui-update-recovery.service

[Timer]
OnCalendar=daily
OnBootSec=5min
Persistent=true
Unit=knxohui-backup-cleanup.service

[Install]
WantedBy=timers.target

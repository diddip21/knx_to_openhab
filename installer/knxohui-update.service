[Unit]
Description=Protected KNX to OpenHAB release updater
Requires=knxohui-update-recovery.service
After=knxohui-update-recovery.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I /usr/local/libexec/knx_to_openhab/update_release.py --run --paths-file /etc/knx_to_openhab/paths.env
Environment=PATH=/usr/bin:/bin LANG=C.UTF-8
UnsetEnvironment=PYTHONPATH PYTHONHOME VIRTUAL_ENV
UMask=0077
LimitNOFILE=32768
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/knx_to_openhab /etc/knx_to_openhab /var/lib/knxohupdate-preparation /run/lock/knxohui-lifecycle.lock
TimeoutStartSec=45min

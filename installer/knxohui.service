[Unit]
Description=KNX to OpenHAB Web UI Service
After=network.target
Wants=knxohui-backup-cleanup.timer

[Service]
Type=notify
User=knxohui
Group=knxohui
EnvironmentFile=/etc/knx_to_openhab/paths.env
ExecStart=/usr/local/libexec/knx_to_openhab/launch_web.sh
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target

# Restricted system service actions for the KNX to openHAB Web UI.
# Git updates run as the service user and do not require sudo.
Cmnd_Alias KNOHUI_SERVICE_COMMANDS = \
    /bin/systemctl restart openhab.service, \
    /usr/bin/systemctl restart openhab.service, \
    /bin/systemctl restart knxohui.service, \
    /usr/bin/systemctl restart knxohui.service, \
    /bin/systemctl restart evcc.service, \
    /usr/bin/systemctl restart evcc.service, \
    /bin/systemctl is-active openhab.service, \
    /usr/bin/systemctl is-active openhab.service, \
    /bin/systemctl is-active knxohui.service, \
    /usr/bin/systemctl is-active knxohui.service, \
    /bin/systemctl is-active evcc.service, \
    /usr/bin/systemctl is-active evcc.service

knxohui ALL=(root) NOPASSWD: KNOHUI_SERVICE_COMMANDS
